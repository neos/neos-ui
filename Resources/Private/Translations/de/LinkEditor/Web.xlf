      </trans-unit>
      <trans-unit id="href.validation.mailtoSchema" xml:space="preserve" approved="no">
        <source>Mail to links should be handled in the mail to tab</source>
        <target state="translated">E-Mail-Links sollten im Tab E-Mail behandelt werden</target>
      </trans-unit>
      <trans-unit id="href.validation.leadingOrTrailingSpace" xml:space="preserve" approved="no">
        <source>Link starts or ends with trailing empty space</source>
        <target state="translated">Link beginnt oder endet mit Leerzeichen</target>
      </trans-unit>
