<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file original="" product-name="Neos.Neos.Ui" source-language="en" datatype="plaintext" target-language="de">
    <body>
      <trans-unit id="confirmation.title" xml:space="preserve">
        <source>Synchronize workspace "{workspaceName}" with "{baseWorkspaceName}"</source>
        <target xml:lang="de" state="translated">Arbeitsbereich "{workspaceName}" mit "{baseWorkspaceName}" synchronisieren</target>
      </trans-unit>
      <trans-unit id="confirmation.message" xml:space="preserve">
        <source>Workspace "{baseWorkspaceName}" has been modified. You need to synchronize your workspace "{workspaceName}" with it in order to see those changes and avoid conflicts. Do you wish to proceed?</source>
        <target xml:lang="de" state="translated">Arbeitsbereich "{baseWorkspaceName}" wurde geändert. Sie müssen Ihren Arbeitsbereich "{workspaceName}" damit synchronisieren, um diese Änderungen zu sehen und Konflikte zu vermeiden. Möchten Sie fortfahren?</target>
      </trans-unit>
      <trans-unit id="confirmation.cancel" xml:space="preserve">
        <source>No, cancel</source>
        <target xml:lang="de" state="translated">Nein, abbrechen</target>
      </trans-unit>
      <trans-unit id="confirmation.confirm" xml:space="preserve">
        <source>Yes, synchronize now</source>
        <target xml:lang="de" state="translated">Ja, jetzt synchronisieren</target>
      </trans-unit>
      <trans-unit id="process.title" xml:space="preserve">
        <source>Synchronizing workspace "{workspaceName}"...</source>
        <target xml:lang="de" state="translated">Arbeitsbereich "{workspaceName}" wird synchronisiert...</target>
      </trans-unit>
      <trans-unit id="process.message" xml:space="preserve">
        <source>Please wait, while workspace "{workspaceName}" is being synchronized with recent changes in workspace "{baseWorkspaceName}". This may take a while.</source>
        <target xml:lang="de" state="translated">Bitte warten Sie, während der Arbeitsbereich "{workspaceName}" mit den aktuellen Änderungen im Arbeitsbereich "{baseWorkspaceName}" synchronisiert wird. Dies kann einen Moment dauern.</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.selection.title" xml:space="preserve">
        <source>Conflicts between workspace "{workspaceName}" and "{baseWorkspaceName}"</source>
        <target xml:lang="de" state="translated">Konflikte zwischen den Arbeitsbereichen "{workspaceName}" und "{baseWorkspaceName}"</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.selection.message" xml:space="preserve">
        <source>Workspace "{baseWorkspaceName}" contains modifications that are in conflict with the changes in workspace "{workspaceName}".</source>
        <target xml:lang="de" state="translated">Arbeitsbereich "{baseWorkspaceName}" enthält Änderungen, die mit den Änderungen im Arbeitsbereich "{workspaceName}" in Konflikt stehen.</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.selection.summary" xml:space="preserve">
        <source>Show information about {numberOfConflicts} conflict(s)</source>
        <target xml:lang="de" state="translated">Informationen zu {numberOfConflicts} Konflikt(en) anzeigen</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.selection.prompt" xml:space="preserve">
        <source>In order to proceed, you need to decide what to do with the conflicting changes:</source>
        <target xml:lang="de" state="translated">Um fortzufahren, müssen Sie entscheiden, wie mit den konfliktbehafteten Änderungen verfahren werden soll:</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.selection.option.FORCE.label" xml:space="preserve">
        <source>Drop conflicting changes</source>
        <target xml:lang="de" state="translated">Konfliktbehaftete Änderungen verwerfen</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.selection.option.FORCE.description" xml:space="preserve">
        <source>This will save all non-conflicting changes, while every conflicting change will be lost.</source>
        <target xml:lang="de" state="translated">Dadurch werden alle nicht konfliktbehafteten Änderungen beibehalten, während alle konfliktbehafteten Änderungen verloren gehen.</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.selection.option.DISCARD_ALL.label" xml:space="preserve">
        <source>Discard workspace "{workspaceName}"</source>
        <target xml:lang="de" state="translated">Arbeitsbereich "{workspaceName}" verwerfen</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.selection.option.DISCARD_ALL.description" xml:space="preserve">
        <source>This will discard all changes in your workspace, including those on other sites.</source>
        <target xml:lang="de" state="translated">Dadurch werden alle Änderungen in Ihrem Arbeitsbereich verworfen, einschließlich der Änderungen auf anderen Sites.</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.selection.cancel" xml:space="preserve">
        <source>Cancel Synchronization</source>
        <target xml:lang="de" state="translated">Synchronisierung abbrechen</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.selection.accept" xml:space="preserve">
        <source>Accept choice and continue</source>
        <target xml:lang="de" state="translated">Auswahl bestätigen und fortfahren</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.DISCARD_ALL.confirmation.title" xml:space="preserve">
        <source>Discard all changes in workspace "{workspaceName}"</source>
        <target xml:lang="de" state="translated">Alle Änderungen im Arbeitsbereich "{workspaceName}" verwerfen</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.DISCARD_ALL.confirmation.message" xml:space="preserve">
        <source>You are about to discard all {numberOfChanges} change(s) in workspace "{workspaceName}". This includes all changes on other sites.

        Do you wish to proceed? Be careful: This cannot be undone!</source>
        <target xml:lang="de" state="translated">Sie sind dabei, alle {numberOfChanges} Änderung(en) im Arbeitsbereich "{workspaceName}" zu verwerfen. Dies umfasst alle Änderungen auf anderen Sites.

        Möchten Sie fortfahren? Vorsicht: Dies kann nicht rückgängig gemacht werden!</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.DISCARD_ALL.confirmation.cancel" xml:space="preserve">
        <source>No, cancel</source>
        <target xml:lang="de" state="translated">Nein, abbrechen</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.DISCARD_ALL.confirmation.confirm" xml:space="preserve">
        <source>Yes, discard everything</source>
        <target xml:lang="de" state="translated">Ja, alles verwerfen</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.FORCE.confirmation.conflicts.label" xml:space="preserve">
        <source>You are about to drop the following changes:</source>
        <target xml:lang="de" state="translated">Sie sind dabei, die folgenden Änderungen zu verwerfen:</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.FORCE.confirmation.message" xml:space="preserve">
        <source>Do you wish to proceed? Be careful: This cannot be undone!</source>
        <target xml:lang="de" state="translated">Möchten Sie fortfahren? Vorsicht: Dies kann nicht rückgängig gemacht werden!</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.FORCE.confirmation.cancel" xml:space="preserve">
        <source>No, cancel</source>
        <target xml:lang="de" state="translated">Nein, abbrechen</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.FORCE.confirmation.confirm" xml:space="preserve">
        <source>Yes, drop those changes</source>
        <target xml:lang="de" state="translated">Ja, diese Änderungen verwerfen</target>
      </trans-unit>
      <trans-unit id="resolutionStrategy.FORCE.confirmation.title" xml:space="preserve">
        <source>Drop conflicting changes in workspace "{workspaceName}"</source>
        <target xml:lang="de" state="translated">Konfliktbehaftete Änderungen im Arbeitsbereich "{workspaceName}" verwerfen</target>
      </trans-unit>
      <trans-unit id="conflictList.typeOfChange.NODE_HAS_BEEN_CHANGED.label" xml:space="preserve">
        <source>"{label}" has been edited.</source>
        <target xml:lang="de" state="translated">"{label}" wurde bearbeitet.</target>
      </trans-unit>
      <trans-unit id="conflictList.typeOfChange.NODE_HAS_BEEN_CREATED.label" xml:space="preserve">
        <source>"{label}" has been created.</source>
        <target xml:lang="de" state="translated">"{label}" wurde erstellt.</target>
      </trans-unit>
      <trans-unit id="conflictList.typeOfChange.NODE_HAS_BEEN_DELETED.label" xml:space="preserve">
        <source>"{label}" has been deleted.</source>
        <target xml:lang="de" state="translated">"{label}" wurde gelöscht.</target>
      </trans-unit>
      <trans-unit id="conflictList.typeOfChange.NODE_HAS_BEEN_MOVED.label" xml:space="preserve">
        <source>"{label}" has been moved.</source>
        <target xml:lang="de" state="translated">"{label}" wurde verschoben.</target>
      </trans-unit>
      <trans-unit id="conflictList.reasonForConflict.NODE_HAS_BEEN_DELETED.label" xml:space="preserve">
        <source>"{label}" or one of its ancestor nodes has been deleted.</source>
        <target xml:lang="de" state="translated">"{label}" oder einer seiner übergeordneten Knoten wurde gelöscht.</target>
      </trans-unit>
      <trans-unit id="conflictList.affectedSite.label" xml:space="preserve">
        <source>Affected Site</source>
        <target xml:lang="de" state="translated">Betroffene Site</target>
      </trans-unit>
      <trans-unit id="conflictList.affectedDocument.label" xml:space="preserve">
        <source>Affected Document</source>
        <target xml:lang="de" state="translated">Betroffenes Dokument</target>
      </trans-unit>
      <trans-unit id="conflictList.typeOfChange.label" xml:space="preserve">
        <source>What was changed?</source>
        <target xml:lang="de" state="translated">Was wurde geändert?</target>
      </trans-unit>
      <trans-unit id="conflictList.reasonForConflict.label" xml:space="preserve">
        <source>Why is there a conflict?</source>
        <target xml:lang="de" state="translated">Warum gibt es einen Konflikt?</target>
      </trans-unit>
      <trans-unit id="conflictList.unknownNode" xml:space="preserve">
        <source>Unknown Node</source>
        <target xml:lang="de" state="translated">Unbekannter Knoten</target>
      </trans-unit>
      <trans-unit id="conflictList.unknownDocument" xml:space="preserve">
        <source>Unknown Document</source>
        <target xml:lang="de" state="translated">Unbekanntes Dokument</target>
      </trans-unit>
      <trans-unit id="conflictList.unknownSite" xml:space="preserve">
        <source>Unknown Site</source>
        <target xml:lang="de" state="translated">Unbekannte Site</target>
      </trans-unit>
      <trans-unit id="success.title" xml:space="preserve">
        <source>Workspace "{workspaceName}" is up-to-date</source>
        <target xml:lang="de" state="translated">Arbeitsbereich "{workspaceName}" ist auf dem neuesten Stand</target>
      </trans-unit>
      <trans-unit id="success.message" xml:space="preserve">
        <source>Workspace "{workspaceName}" has been successfully synchronized with all recent changes in workspace "{baseWorkspaceName}".</source>
        <target xml:lang="de" state="translated">Arbeitsbereich "{workspaceName}" wurde erfolgreich mit allen aktuellen Änderungen im Arbeitsbereich "{baseWorkspaceName}" synchronisiert.</target>
      </trans-unit>
      <trans-unit id="success.acknowledge" xml:space="preserve">
        <source>OK</source>
        <target xml:lang="de" state="translated">OK</target>
      </trans-unit>
      <trans-unit id="error.title" xml:space="preserve">
        <source>Workspace "{workspaceName}" could not be synchronized</source>
        <target xml:lang="de" state="translated">Arbeitsbereich "{workspaceName}" konnte nicht synchronisiert werden</target>
      </trans-unit>
      <trans-unit id="error.message" xml:space="preserve">
        <source>Workspace "{workspaceName}" could not be synchronized with the recent changes in workspace "{baseWorkspaceName}".</source>
        <target xml:lang="de" state="translated">Arbeitsbereich "{workspaceName}" konnte nicht mit den aktuellen Änderungen im Arbeitsbereich "{baseWorkspaceName}" synchronisiert werden.</target>
      </trans-unit>
      <trans-unit id="error.acknowledge" xml:space="preserve">
        <source>Cancel</source>
        <target xml:lang="de" state="translated">Abbrechen</target>
      </trans-unit>
      <trans-unit id="error.retry" xml:space="preserve">
        <source>Try again</source>
        <target xml:lang="de" state="translated">Erneut versuchen</target>
      </trans-unit>
    </body>
  </file>
</xliff>
